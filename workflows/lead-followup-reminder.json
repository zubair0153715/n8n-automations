{"name": "Lead Follow-up Reminder (AR+EN)", "nodes": [{"id": "l1-4000-8000-000000000001", "name": "Daily Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.4, "position": [240, 300], "parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 24}]}, "options": {}}}, {"id": "l2-4000-8000-000000000002", "name": "Get Leads", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [460, 300], "parameters": {"resource": "sheetWithinDocument", "operation": "read", "documentId": {"__rl": true, "mode": "id", "value": ""}, "sheetName": {"__rl": true, "mode": "name", "value": "Leads"}, "options": {}}, "credentials": {}}, {"id": "l3-4000-8000-000000000003", "name": "Silent 3+ Days?", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [680, 300], "parameters": {"mode": "runOnceForAllItems", "jsCode": "const now = new Date();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.phone || !j.last_contact) continue;\n  const days = Math.floor((now - new Date(j.last_contact)) / 86400000);\n  if (days < 3) continue;\n  const name = j.name || '';\n  const msg = 'مرحباً ' + name + ' 👋\\nمرت ' + days + ' أيام منذ آخر تواصل بيننا — هل ما زلت مهتماً؟ يسعدنا مساعدتك في أي وقت.\\n\\nHi ' + name + ' 👋\\nIt has been ' + days + ' days since we last spoke — are you still interested? We are happy to help anytime.';\n  out.push({ json: { ...j, days_silent: days, followup_msg: msg, today: now.toISOString().slice(0, 10) } });\n}\nreturn out;"}}, {"id": "l4-4000-8000-000000000004", "name": "WhatsApp Follow-up", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [900, 300], "parameters": {"method": "POST", "url": "https://graph.facebook.com/v22.0/YOUR_PHONE_NUMBER_ID/messages", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer YOUR_WHATSAPP_ACCESS_TOKEN"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"={{ $json.phone }}\",\"type\":\"text\",\"text\":{\"body\":\"={{ $json.followup_msg }}\"}}", "options": {"timeout": 10000}}}, {"id": "l5-4000-8000-000000000005", "name": "Mark Sent (Sheet)", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [1120, 300], "parameters": {"resource": "sheetWithinDocument", "operation": "appendOrUpdate", "documentId": {"__rl": true, "mode": "id", "value": ""}, "sheetName": {"__rl": true, "mode": "name", "value": "Leads"}, "columns": {"mappingMode": "defineBelow", "matchingColumns": ["phone"], "schema": [], "value": {"phone": "={{ $json.phone }}", "last_contact": "={{ $json.today }}", "followup_sent": "yes"}}, "options": {}}, "credentials": {}}], "connections": {"Daily Schedule": {"main": [[{"node": "Get Leads", "type": "main", "index": 0}]]}, "Get Leads": {"main": [[{"node": "Silent 3+ Days?", "type": "main", "index": 0}]]}, "Silent 3+ Days?": {"main": [[{"node": "WhatsApp Follow-up", "type": "main", "index": 0}]]}, "WhatsApp Follow-up": {"main": [[{"node": "Mark Sent (Sheet)", "type": "main", "index": 0}]]}}, "pinData": {}, "settings": {"executionOrder": "v1"}, "staticData": null}